# Copy to .env and fill in. .env is never committed.

# Salt for hashing platform account IDs (any long random string; keep it private and stable).
CIB_SALT=

# The cloud environment proxy injects the real key; code only needs a placeholder.
OPENAI_API_KEY=proxy-injected

# Hard stop for paid API spending, USD.
BUDGET_STOP_USD=40

# Only for scripts/export_vk_corpus.py run on the author's machine.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/civic
